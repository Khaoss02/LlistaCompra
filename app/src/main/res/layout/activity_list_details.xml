<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFDE7"
    android:padding="16dp">

    <!-- Capçalera: Títol i Botons d'acció -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#37474F"
            android:text="Productes" />

        <ImageButton
            android:id="@+id/btnToggleVisibility"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_eye"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Amagar o mostrar marcats"
            app:tint="#FBC02D"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_share"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Compartir llista"
            app:tint="#FBC02D"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Barra d'entrada de productes REAJUSTADA -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="#FFE082"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">

            <EditText
                android:id="@+id/etProductName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nou producte"
                android:background="@android:color/transparent"
                android:padding="16dp"
                android:inputType="textCapSentences"
                android:textColor="#37474F"
                android:textColorHint="#9E9E9E"
                android:textSize="18sp" />

            <!-- Spinner con ancho fijo para asegurar visibilidad -->
            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#FBC02D"
                android:dropDownWidth="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddProduct"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:text="+"
                android:textSize="24sp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="14dp"
                app:backgroundTint="#FBC02D"
                android:textColor="@android:color/black" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <!-- Llista de productes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProducts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        tools:listitem="@android:layout/simple_list_item_multiple_choice" />

</LinearLayout>
